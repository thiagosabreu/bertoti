@startuml
title Cenário Antí-Padrão - Falha de Acoplamento (Com Herança)

' Configuração visual
skinparam class {
  BorderColor #4078c0
  BackgroundColor white
  AttributeFontColor black
}
skinparam backgroundcolor white

' 1. Classe Base (antes era Interface)
class TomadaAmericana {
  -- Métodos --
  + conectarNaTomadaAmericana(): void
}

' 2. Classe Adaptada (Adaptee)
class PlugEuropeu {
  -- Métodos --
  + conectarNaTomadaEuropeia(): void
}

' 3. Classe Adapter (Agora herda a classe alvo)
class AdapterEuropeuParaAmericano {
  -- Atributos --
  - plug: PlugEuropeu
  -- Métodos --
  + conectarNaTomadaAmericana(): void
}

' 4. Classe Cliente (O problema)
class MainErrado {
    -- Métodos --
    + main(args: String[]): void
}

' RELAÇÕES:

' Herança (antes era implementação de interface)
AdapterEuropeuParaAmericano --|> TomadaAmericana

' Agregação 1:1 (Adapter contém o PlugEuropeu)
AdapterEuropeuParaAmericano "1" o-- "1" PlugEuropeu

' Dependência incorreta (Cliente usa diretamente o PlugEuropeu)
MainErrado .right.> PlugEuropeu

@enduml

@startuml
title ❌ Anti-Padrão: Baixa Coesão (God Object) - Com Herança

' Configuração de estilo
skinparam class {
  BorderColor #cc0000
  BackgroundColor white
  AttributeFontColor black
}
skinparam backgroundcolor white

' Classe base
class Loja {
  -- Métodos --
  + limparLoja(): void
}

' Classe filha com responsabilidades demais (God Object)
class Confeitaria {
  -- Métodos --
  + fazerBolo(): void
  + venderDoce(): void
  + limparLoja(): void
}

' Herança (Confeitaria herda Loja)
Confeitaria --|> Loja

@enduml

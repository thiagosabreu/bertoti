@startuml
title Padrão Adapter Implementado (Adapter de Objeto) - Corrigido

' Configuração de estilo (sem fundo)
skinparam class {
  BorderColor #4078c0
  BackgroundColor white
  AttributeFontColor black
}
skinparam interface {
  BorderColor #6cc644
  BackgroundColor white
  AttributeFontColor black
}
skinparam backgroundcolor white

' 1. Interface (Target - Alvo)
interface TomadaAmericana {
  -- Métodos --
  + conectarNaTomadaAmericana(): void
}

' 2. Classe Adaptada (Adaptee)
class PlugEuropeu {
  -- Métodos --
  + conectarNaTomadaEuropeia(): void
}

' 3. Classe Adapter (Adaptador)
class AdapterEuropeuParaAmericano {
  -- Atributos --
  - plug: PlugEuropeu
  -- Métodos --
  + conectarNaTomadaAmericana(): void
}

' 4. Nova Classe Cliente
class DispositivoEletrico {
  -- Atributos --
  - tomada: TomadaAmericana
  -- Métodos --
  + ligar(): void
}

' RELAÇÕES:

' Implementação (Adapter implementa Target)
AdapterEuropeuParaAmericano ..|> TomadaAmericana

AdapterEuropeuParaAmericano "1" o-- "1" PlugEuropeu

' Agregação (Cliente possui uma TomadaAmericana)
DispositivoEletrico "1" o-- "1" TomadaAmericana

@enduml

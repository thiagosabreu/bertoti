@startuml
title ✔️ Padrão: Alta Coesão e Separação de Responsabilidades

' Configuração de estilo
skinparam class {
  BorderColor #2e7d32
  BackgroundColor white
  AttributeFontColor black
}
skinparam backgroundcolor white

' Serviços com responsabilidades coesas
class BoloService {
  + fazerBolo(): void
}

class VendasService {
  + venderDoce(): void
}

class LimpezaService {
  + limparLoja(): void
}

' Classe que orquestra (Alta Coesão + Delegação)
class Confeitaria {
  - boloService: BoloService
  - vendasService: VendasService
  - limpezaService: LimpezaService

  + fazerBolo(): void
  + venderDoce(): void
  + limparLoja(): void
}

' Cliente
class Cliente {
  + realizarAtividade(): void
}

' RELAÇÕES:

' Composição (Confeitaria depende dos serviços — ciclo de vida compartilhado)
Confeitaria *-- BoloService
Confeitaria *-- VendasService
Confeitaria *-- LimpezaService

' Cliente usa Confeitaria
Cliente --> Confeitaria

@enduml
